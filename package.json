{
  "name": "aries",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "brace-expansion@<2": "1.1.18"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grommet/hpe-design-system.git"
  },
  "bugs": {
    "url": "https://github.com/grommet/hpe-design-system/issues"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.0.1",
    "@babel/eslint-parser": "^7.29.9",
    "@babel/preset-react": "catalog:",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "catalog:",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "concurrently": "^9.2.5",
    "eslint": "catalog:",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-grommet": "https://github.com/grommet/eslint-plugin-grommet/tarball/stable",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx": "^0.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "husky": "^8.0.3",
    "jest": "^27.5.1",
    "prettier": "catalog:",
    "remark-gfm": "^4.0.0",
    "ts-json-schema-generator": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@changesets/cli": "^3.0.3",
    "@hpe-design/icons-grommet": "catalog:",
    "grommet": "catalog:",
    "grommet-theme-hpe": "catalog:",
    "styled-components": "catalog:"
  },
  "scripts": {
    "prepare": "husky install",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint --cache",
    "license": "node ./scripts/license-header.mjs",
    "license-check": "node ./scripts/license-header.mjs --check",
    "license-staged": "node ./scripts/license-header.mjs --staged",
    "validate:capability-manifests": "node scripts/validate-capability-manifests.mjs",
    "validate:docs-creation-page": "node knowledge/capabilities/docs-creation/scripts/validate-page.mjs",
    "validate:design-tokens-changeset": "node scripts/validate-design-tokens-changeset.mjs",
    "validate:knowledge-format": "prettier --check \"knowledge/**/*.{yaml,yml}\"",
    "validate:knowledge-schema": "tsx scripts/validate-knowledge-schema.ts",
    "validate:knowledge-structure": "node scripts/validate-knowledge-structure.mjs",
    "test:knowledge-structure": "node --test scripts/knowledge-references.test.mjs",
    "dev:tokens:grommet-app": "concurrently --kill-others --success=first --names tokens,hooks,app \"pnpm --filter hpe-design-tokens watch\" \"pnpm --filter @shared/hooks watch\" \"pnpm --filter grommet-app dev\"",
    "dev:tokens:storybook": "concurrently --kill-others --success=first --names tokens,hooks,storybook \"pnpm --filter hpe-design-tokens watch\" \"pnpm --filter @shared/hooks watch\" \"pnpm --filter @shared/aries-core storybook:dev\"",
    "telemetry:write": "node scripts/telemetry-write.mjs",
    "telemetry:status": "node scripts/telemetry-status.mjs",
    "start:docs": "pnpm --filter docs start",
    "start:design-tokens-manager": "pnpm --filter design-tokens-manager dev",
    "start:grommet-app": "pnpm --filter grommet-app dev",
    "storybook:icons-grommet": "pnpm --filter \"@hpe-design/icons-grommet\" storybook",
    "storybook:core": "pnpm --filter \"@shared/aries-core\" storybook"
  }
}
