{
  "name": "@hpe-design/knowledge-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Offline HPE Design System context for React/Grommet projects",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grommet/hpe-design-system.git",
    "directory": "packages/knowledge-agent"
  },
  "exports": {
    ".": {
      "types": "./dist/packages/knowledge-agent/src/index.d.ts",
      "import": "./dist/packages/knowledge-agent/src/index.js"
    }
  },
  "types": "./dist/packages/knowledge-agent/src/index.d.ts",
  "files": [
    "bin/cli.js",
    "dist",
    "README.md"
  ],
  "bin": {
    "hpe-design-agent": "bin/cli.js"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "prepack": "pnpm run build",
    "generate": "tsx src/cli.ts",
    "test:package": "pnpm run build && tsx scripts/test-package.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
