{
  "name": "hpe-design-token-resolver",
  "displayName": "HPE Design Token Resolver",
  "description": "Shows resolved HPE design token values when hovering supported Grommet t-shirt sizes and HPE CSS variables.",
  "version": "0.6.33",
  "publisher": "hpe-design",
  "type": "commonjs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/grommet/hpe-design-system.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:css",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:less",
    "onLanguage:scss",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "configuration": {
      "title": "HPE Design Tokens",
      "properties": {
        "hpeDesignTokens.manifestPath": {
          "type": "string",
          "default": "",
          "description": "Optional workspace-relative or absolute path to an HPE IDE token manifest."
        },
        "hpeDesignTokens.dimensionMode": {
          "type": "string",
          "default": "default",
          "description": "Dimension mode to resolve when the manifest provides multiple modes."
        },
        "hpeDesignTokens.colorMode": {
          "type": "string",
          "default": "light",
          "enum": [
            "light",
            "dark"
          ],
          "description": "Color mode to resolve when the manifest provides multiple modes."
        }
      }
    }
  },
  "scripts": {
    "test": "jest --runInBand",
    "build:tokens": "pnpm --dir ../hpe-design-tokens build",
    "package": "pnpm build:tokens && node scripts/package-vsix.cjs"
  },
  "dependencies": {
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "jest": "^27.5.1"
  }
}
